{
  "name": "hyderabad-metro-delivery",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mobile-browser Three.js delivery game on real Hyderabad roads near the metro corridors.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "import:map": "node scripts/import-map.mjs",
    "validate:world": "node scripts/validate-world.mjs",
    "build:world": "node scripts/import-map.mjs && node scripts/validate-world.mjs",
    "verify:ledger": "python3 monitoring/verify_run.py --root . --status qa/status.json --requirements requirements.json --scope scope-manifest.json --evidence qa/evidence-index.json"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "fast-xml-parser": "5.11.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
