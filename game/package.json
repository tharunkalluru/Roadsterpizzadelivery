{
  "name": "hyderabad-metro-delivery",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Mobile-browser Three.js delivery game on real Hyderabad roads near the metro corridors.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "import:map": "node scripts/import-map.mjs",
    "validate:world": "node scripts/validate-world.mjs",
    "build:world": "node scripts/import-map.mjs && node scripts/validate-world.mjs",
    "verify:ledger": "python3 monitoring/verify_run.py --root . --status qa/status.json --requirements requirements.json --scope scope-manifest.json --evidence qa/evidence-index.json",
    "fetch:overture": ".venv-data/bin/python scripts/overture/fetch.py && .venv-data/bin/python scripts/overture/preprocess.py",
    "import:world": ".venv-data/bin/python scripts/overture/preprocess.py && node scripts/import-world-v2.mjs --project-files",
    "validate:world:v2": "node scripts/validate-world.mjs --v2",
    "survey:validate": "node --experimental-strip-types scripts/survey-validate.mjs",
    "survey:network": "node --experimental-strip-types scripts/survey-network.mjs",
    "survey:check": "node --experimental-strip-types scripts/survey-network.mjs --check",
    "food:build": "node scripts/build-food-pickups.mjs",
    "source:heights": ".venv-data/bin/python scripts/source_accuracy/heights.py",
    "source:build": ".venv-data/bin/python scripts/source_accuracy/build.py --write",
    "source:check": ".venv-data/bin/python scripts/source_accuracy/build.py --check",
    "source:test": ".venv-data/bin/python -m unittest discover -s scripts/source_accuracy -p 'test_*.py' -v",
    "postinstall": "node scripts/restore-runtime-data.mjs",
    "setup:data": "node scripts/restore-runtime-data.mjs",
    "archive:data": "node scripts/restore-runtime-data.mjs --pack",
    "prebuild": "node scripts/restore-runtime-data.mjs",
    "predev": "node scripts/restore-runtime-data.mjs",
    "pretest": "node scripts/restore-runtime-data.mjs",
    "presurvey:validate": "node scripts/restore-runtime-data.mjs",
    "presurvey:check": "node scripts/restore-runtime-data.mjs",
    "presurvey:network": "node scripts/restore-runtime-data.mjs",
    "prevalidate:world": "node scripts/restore-runtime-data.mjs",
    "prevalidate:world:v2": "node scripts/restore-runtime-data.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "fast-xml-parser": "5.11.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
